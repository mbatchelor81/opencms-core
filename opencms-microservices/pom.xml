<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.opencms</groupId>
    <artifactId>opencms-microservices-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>OpenCms Microservices</name>
    <description>Microservice architecture for OpenCms CMS</description>

    <modules>
        <!-- Shared libraries -->
        <module>opencms-shared/opencms-common</module>
        <module>opencms-shared/opencms-api-contracts</module>
        <module>opencms-shared/opencms-event-bus</module>
        <module>opencms-shared/opencms-security-common</module>
        <module>opencms-shared/opencms-legacy-adapter</module>

        <!-- Services -->
        <module>opencms-api-gateway</module>
        <module>opencms-identity-service</module>
        <module>opencms-content-service</module>
        <module>opencms-publishing-service</module>
        <module>opencms-module-service</module>
        <module>opencms-rendering-service</module>
        <module>opencms-search-service</module>

        <!-- Migration tools -->
        <module>opencms-migration-tools/data-migration</module>
        <module>opencms-migration-tools/dual-write-proxy</module>
        <module>opencms-migration-tools/compatibility-tests</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Spring Boot -->
        <spring-boot.version>3.2.0</spring-boot.version>
        <spring-cloud.version>2023.0.0</spring-cloud.version>

        <!-- Database -->
        <postgresql.version>42.7.1</postgresql.version>
        <flyway.version>10.4.1</flyway.version>

        <!-- Caching & Messaging -->
        <redis.version>3.2.0</redis.version>
        <kafka.version>3.6.1</kafka.version>

        <!-- Cloud & Observability -->
        <micrometer.version>1.12.1</micrometer.version>
        <feign.version>4.1.0</feign.version>

        <!-- Testing -->
        <junit.version>5.10.1</junit.version>
        <testcontainers.version>1.19.3</testcontainers.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud BOM -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Internal modules -->
            <dependency>
                <groupId>org.opencms</groupId>
                <artifactId>opencms-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.opencms</groupId>
                <artifactId>opencms-api-contracts</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Database -->
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>

            <!-- Testing -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
